{
  "name": "pinyinsousuo",
  "displayName": "PinyinSousuo",
  "description": "拼音搜索 — 支持拼音匹配的文件搜索插件",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
"main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pinyinsousuo.searchFiles",
        "title": "拼音搜索：搜索文件"
      }
    ],
    "keybindings": [
      {
        "command": "pinyinsousuo.searchFiles",
        "key": "alt+p",
        "mac": "alt+p"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.18",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "pinyin-match": "^1.2.10"
  }
}
